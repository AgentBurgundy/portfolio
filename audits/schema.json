{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Baker verified public-presence snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "companyName", "website", "snapshotDate", "publicationApproved", "metrics", "observations", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "companyName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "website": { "$ref": "#/definitions/url" },
    "snapshotDate": { "$ref": "#/definitions/date" },
    "publicationApproved": { "const": true },
    "scope": { "type": "string", "minLength": 1, "maxLength": 180 },
    "limitations": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 180 } },
    "metrics": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "value", "context", "sourceIds"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "value": { "type": "string", "minLength": 1, "maxLength": 18 },
          "context": { "type": "string", "minLength": 1, "maxLength": 110 },
          "sourceIds": { "$ref": "#/definitions/sourceIds" }
        }
      }
    },
    "observations": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "observed", "improvement", "sourceIds"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 70 },
          "observed": { "type": "string", "minLength": 1, "maxLength": 220 },
          "improvement": { "type": "string", "minLength": 1, "maxLength": 160 },
          "sourceIds": { "$ref": "#/definitions/sourceIds" }
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "url", "observedOn"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "url": { "$ref": "#/definitions/url" },
          "observedOn": { "$ref": "#/definitions/date" },
          "context": { "type": "string", "minLength": 1, "maxLength": 140 }
        }
      }
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "minLength": 10, "maxLength": 1500, "pattern": "^https://" },
    "sourceIds": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  }
}
